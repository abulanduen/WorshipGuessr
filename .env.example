# Postgres connection string (Vercel Postgres/Prisma Postgres, Neon, Supabase, etc.)
DATABASE_URL=""

# Cloudflare R2 (S3-compatible) — audio clips are stored here, no local-disk fallback.
# Create a bucket at dash.cloudflare.com -> R2, enable public access on it (either the
# bucket's r2.dev subdomain or your own custom domain), and create an API token scoped
# to that bucket with read+write permissions.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# The bucket's public base URL, no trailing slash — e.g. https://pub-xxxxxxxx.r2.dev
# or https://clips.yourdomain.com if you attached a custom domain.
R2_PUBLIC_URL=""

# Optional: set a passcode to protect setlist-editing actions (add/delete/import songs,
# clear setlist) behind a simple shared-secret cookie. Leave blank to disable.
SETLIST_PASSCODE=""
